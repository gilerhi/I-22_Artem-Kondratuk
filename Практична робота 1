#I-22_Artem-Kondratuk
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Реєстрація на спортивний захід</title>
</head>
<body>
    <h1>Реєстрація на спортивний захід</h1>
    <form>
        <label for="name">Ім'я</label>
        <input 
            type="text" 
            id="name" 
            name="name" 
            placeholder="Введіть ім'я" 
            required
        >
        <br><br>
        <label for="surname">Прізвище</label>
        <input 
            type="text" 
            id="surname" 
            name="surname" 
            placeholder="Введіть прізвище" 
            required
        >
        <br><br>
        <label for="email">Електронна пошта</label>
        <input 
            type="email" 
            id="email" 
            name="email" 
            placeholder="Введіть email" 
            required
        >
        <br><br>
        <label for="phone">Номер телефону</label>
        <input 
            type="tel" 
            id="phone" 
            name="phone" 
            placeholder="Введіть номер телефону"
        >
        <br><br>
        <label for="age">Вік</label>
        <input 
            type="number" 
            id="age" 
            name="age" 
            min="12" 
            max="80"
        >
        <br><br>
        <label for="date">Дата участі</label>
        <input 
            type="date" 
            id="date" 
            name="date" 
            required
        >
        <br><br>
        <p>Оберіть дистанцію:</p>
        <input type="radio" id="dist2" name="distance" value="2km" required>
        <label for="dist2">2 км</label>
        <input type="radio" id="dist5" name="distance" value="5km">
        <label for="dist5">5 км</label>
        <input type="radio" id="dist10" name="distance" value="10km">
        <label for="dist10">10 км</label>
        <br><br>
        <p>Додаткові можливості:</p>
        <input type="checkbox" id="tshirt" name="tshirt" value="tshirt">
        <label for="tshirt">Отримати футболку</label>
        <input type="checkbox" id="medal" name="medal" value="medal">
        <label for="medal">Отримати медаль</label>
        <input type="checkbox" id="news" name="news" value="news">
        <label for="news">Отримувати новини про наступні заходи</label>
        <input type="checkbox" id="rating" name="rating" value="rating">
        <label for="rating">Додати результати до загального рейтингу</label>
        <br><br>
        <label for="category">Категорія учасника</label>
        <select name="category" id="category">
            <option value="student_school">Учень</option>
            <option value="student">Студент</option>
            <option value="adult">Дорослий</option>
            <option value="other">Інша категорія</option>
        </select>
        <br><br>
        <label for="info">Додаткова інформація для організаторів</label>
        <br>
        <textarea 
            name="info" 
            id="info" 
            maxlength="250" 
            placeholder="Введіть додаткову інформацію"
        ></textarea>
        <br><br>
        <button type="submit">Відправити</button>
        <button type="reset">Очистити</button>
    </form>
</body>

</html>
